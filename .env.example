# Generate a long random value for production.
SECRET_KEY=replace-with-a-long-random-secret
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_FROM=your_email@example.com
SMTP_PASSWORD=replace-with-your-smtp-password
FRONTEND_RESET_URL=https://your-site.com/reset-password

# Docker: PostgreSQL on the Docker host. Replace credentials and database name.
# For PostgreSQL on another server, replace host.docker.internal with its hostname.
# Without Docker, use 127.0.0.1 if PostgreSQL runs on this computer.
DATABASE_URL=postgresql+psycopg2://app_user:replace-password@host.docker.internal:5432/kyrgyzgo_db

GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EXTRACT_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=LOW
GEMINI_MAX_RETRIES=1
CHAT_MAX_OUTPUT_TOKENS=1536
CHAT_EXTRACT_MAX_OUTPUT_TOKENS=512
CHAT_HISTORY_MESSAGES=12
CHAT_HISTORY_CHARACTERS=8000

# Semicolon-separated frontend origins, without a trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:3000;http://127.0.0.1:3000;http://localhost:5173;http://127.0.0.1:5173
CHAT_ALLOWED_ORIGINS=http://localhost:3000;http://127.0.0.1:3000;http://localhost:5173;http://127.0.0.1:5173

# Keep the API on localhost behind a host HTTPS reverse proxy.
# For direct access from other computers, explicitly set API_BIND_HOST=0.0.0.0.
API_BIND_HOST=127.0.0.1
API_PORT=8000

# HTTPS proxy from docker-compose.yml; enable with --profile https.
# For a domain, DNS must point to your server.
API_DOMAIN=13.53.40.37
# Alternatively, enable HTTPS for plain `docker compose up`:
# COMPOSE_PROFILES=https

# Set to * ONLY when all connections to Uvicorn come through a trusted proxy.
# Needed for HTTPS redirects behind a host reverse proxy via Docker networking.
# FORWARDED_ALLOW_IPS=*
