## Generate a long random value for production.
SECRET_KEY=replace-with-a-long-random-secret

# Docker: PostgreSQL on the Docker host. Replace credentials and database name.
# For PostgreSQL on another server, replace host.docker.internal with its hostname.
# Without Docker, use 127.0.0.1 if PostgreSQL runs on this computer.
DATABASE_URL=postgresql+psycopg2://app_user:replace-password@host.docker.internal:5432/kyrgyzgo_db
# DATABASE_URL=postgresql+psycopg2://app_user:replace-password@127.0.0.1:5432/kyrgyzgo_db
# Tests use a separate connection with CREATEDB permission (never the app tables).
# TEST_DATABASE_URL=postgresql+psycopg2://test_user:replace-password@127.0.0.1:5432/postgres
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EXTRACT_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=MINIMAL
GEMINI_MAX_RETRIES=1
CHAT_MAX_OUTPUT_TOKENS=1536
# Total consultation deadline (extraction, model rounds and tools), 10-170 seconds.
CHAT_RESPONSE_TIMEOUT=150
CHAT_EXTRACT_MAX_OUTPUT_TOKENS=512
CHAT_HISTORY_MESSAGES=12
CHAT_HISTORY_CHARACTERS=8000

# Semicolon-separated frontend origins, without a trailing slash.
CORS_ALLOWED_ORIGINS=https://kerben-travel.vercel.app;http://localhost:3000;http://127.0.0.1:3000;http://localhost:5173;http://127.0.0.1:5173
CHAT_ALLOWED_ORIGINS=https://kerben-travel.vercel.app;http://localhost:3000;http://127.0.0.1:3000;http://localhost:5173;http://127.0.0.1:5173

# Keep the API on localhost behind a host HTTPS reverse proxy.
# For direct access from other computers, explicitly set API_BIND_HOST=0.0.0.0.
API_BIND_HOST=127.0.0.1
API_PORT=8000
# /metrics is disabled unless this bearer token is configured (minimum 32 chars).
# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
METRICS_BEARER_TOKEN=
RATE_LIMIT_ENABLED=true
HTTP_REQUESTS_PER_MINUTE=120
# GET requests of one address per minute; a site page reads the catalogue many times.
HTTP_READS_PER_MINUTE=600
# false on production hides /docs, /redoc and /openapi.json.
API_DOCS=true
HTTP_IP_BUCKETS=8192
# Uploads have their own pool: a slow upload may last minutes without taking API slots.
UPLOAD_MAX_CONCURRENT=8
UPLOAD_MAX_PER_IP=2
HTTP_MAX_CONCURRENT=64
MAX_REQUEST_BODY_BYTES=1048576
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_VIDEO_UPLOAD_BYTES=104857600
# ffprobe must be installed on the API server (included in the Docker image).
FFPROBE_BINARY=ffprobe
REQUEST_BODY_TIMEOUT=10
WS_MAX_CONNECTIONS=64
WS_MAX_PER_IP=8
# Open chats of one client after login; a silent chat is closed after WS_IDLE_SECONDS.
WS_MAX_PER_CLIENT=8
WS_IDLE_SECONDS=600
WS_AUTH_SECONDS=10
AI_MAX_CONCURRENT=4
# Replies written at once for one client and for one address; both stay below
# AI_MAX_CONCURRENT. A message waits up to AI_QUEUE_SECONDS for a free place.
AI_MAX_PER_CLIENT=2
AI_MAX_PER_IP=3
AI_QUEUE_SECONDS=5
# Daily Gemini token budgets of the chat (UTC day): everyone, one client, one address.
# Agree AI_DAILY_TOKENS with the customer: above it the chat refuses until the next day.
AI_DAILY_TOKENS=20000000
AI_CLIENT_DAILY_TOKENS=1000000
AI_IP_DAILY_TOKENS=3000000
AUTH_MAX_CONCURRENT=4
# Enable on the HTTPS production server; keep false for local HTTP development.
ADMIN_COOKIE_SECURE=true
# Keep 60 during the backend-first rollout; set 15 after the admin frontend supports refresh.
ADMIN_ACCESS_TOKEN_MINUTES=60
ADMIN_REFRESH_DAYS=30
ADMIN_SESSION_HOURS=168
GEMINI_REQUESTS_PER_MINUTE=10
# Compose serves media with Caddy; this flag is for standalone local development.
SERVE_MEDIA_LOCALLY=true
# Admin pages are reachable from any IP; account login is still required.
API_MEMORY_LIMIT=1g
API_CPU_LIMIT=2.0

# HTTPS proxy from docker-compose.yml; enable with --profile https.
# For a domain, DNS must point to your server.
API_DOMAIN=your-server-ip-or-domain
# Alternatively, enable HTTPS for plain `docker compose up`:
# COMPOSE_PROFILES=https

# Trust only Caddy's fixed address in the dedicated proxy network.
# If this subnet overlaps a local network, change all four related values together.
PROXY_SUBNET=172.30.240.0/28
CADDY_PROXY_IP=172.30.240.2
API_PROXY_IP=172.30.240.3
FORWARDED_ALLOW_IPS=172.30.240.2

# Social sign-in (Google Identity Services client ID(s), comma separated; Facebook app)
GOOGLE_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Radius (km) for hotels/transport offered after a tour is chosen
TRIP_OPTION_RADIUS_KM=100
