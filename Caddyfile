{
    default_sni {$API_DOMAIN}
}

{$API_DOMAIN} {
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            profile shortlived
        }
    }
    handle_path /media/* {
        root * /srv/media
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        reverse_proxy api:8000
    }
}
