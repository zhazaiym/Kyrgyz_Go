{
    default_sni {$API_DOMAIN}
}

{$API_DOMAIN} {
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            profile shortlived
        }
    }
    @admin_outside_vpn {
        path /admin*
        not remote_ip {$ADMIN_ALLOWED_CIDR}
    }
    respond @admin_outside_vpn 403
    reverse_proxy api:8000
}
